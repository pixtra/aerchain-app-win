# Runtime LlM keys — never commit this file, add your credentials here.
# Copied from .env.example; values here override nothing already exported in your shell.

# OpenAI-compatible endpoint (required):
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Or any OpenAI-compatible host:
# KTQ_LLM_URL=http://localhost:1234/v1
# KTQ_LLM_KEY=not-needed
# KTQ_LLM_MODEL=qwen2.5:7b-instruct

# Cloud APIs (free tiers work; OpenAI-compatible). Listed FIRST automatically;
# on 429/5xx/timeout the app falls back to local Ollama, and every Copilot
# answer is stamped with the provider that actually served it.
# Groq (fast, no training on your data):
# KTQ_LLM_URL=https://api.groq.com/openai/v1
# KTQ_LLM_KEY=gsk-...
# KTQ_LLM_MODEL=openai/gpt-oss-20b
# Google Gemini:
# KTQ_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# KTQ_LLM_KEY=AIza...
# KTQ_LLM_MODEL=gemini-2.5-flash
# Local model override (defaults to qwen2.5:7b-instruct once cloud is set):
# KTQ_OLLAMA_MODEL=qwen2.5:7b-instruct

# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local Ollama (no key) — put your model name here:
# OLLAMA_HOST=http://localhost:11434
# KTQ_LLM_MODEL=qwen2.5:7b-instruct

# Ollama tuning (optional): keep the model resident between questions and cap
# the context / output so answers stay fast on CPU-only machines.
# KTQ_OLLAMA_KEEP_ALIVE=15m
# KTQ_OLLAMA_NUM_CTX=8192
# KTQ_OLLAMA_NUM_PREDICT=2048